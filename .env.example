# Expression Engine Database Configuration
EE_DB_HOST=127.0.0.1
EE_DB_PORT=3306
EE_DB_USER=root
EE_DB_PASSWORD=
EE_DB_DATABASE=expressionengine

# Expression Engine Installation Path
# For Devilbox, this is typically the path inside the PHP container
EE_BASE_PATH=/shared/httpd/expressionengine

# Example for different setups:
# Local installation: /var/www/html/expressionengine
# Docker bind mount: /app/expressionengine
# Devilbox: /shared/httpd/expressionengine
